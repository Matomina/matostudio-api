NODE_ENV=development
PORT=3000

# Development (SQLite was used previously — now PostgreSQL is required)
# For local dev: install PostgreSQL or use a free cloud instance (e.g. Supabase, Neon)
DATABASE_URL=postgresql://user:password@localhost:5432/matostudio_dev

# Production (Render PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

JWT_SECRET=change-me-use-a-long-random-string-in-production
ADMIN_PASS_HASH=generate-with-scripts/generate-admin-hash.ts

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,https://matostudio.fr,https://www.matostudio.fr

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

MAIL_FROM="MatoStudio <noreply@matostudio.fr>"
MAIL_TO=contact@matostudio.fr

# ──────────────────────────────────────────────────────────
# Render deployment — set these in Render Environment Groups
# ──────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://...?sslmode=require    (from Render PostgreSQL add-on)
# JWT_SECRET=<long random string>
# ADMIN_PASS_HASH=<bcrypt hash — generate with: npx tsx scripts/generate-admin-hash.ts>
# FRONTEND_ORIGINS=https://matostudio.fr,https://www.matostudio.fr
# NODE_ENV=production
# PORT=10000
#
# Render Build Command:  npm ci && npm run build
# Render Start Command:  npm run start:prod
