generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id           String   @id @default(cuid())
  type         String
  name         String
  email        String
  phone        String?
  projectType  String
  budget       String?
  timeline     String?
  pageCount    Int?
  options      String?
  deadline     String?
  estimate     Float?
  message      String?
  status       String   @default("new")
  internalNote String?
  reference    String?
  finalAmount  Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  emailLogs      EmailLog[]
  paymentRequest PaymentRequest?
}

model EmailLog {
  id                String    @id @default(cuid())
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id])
  type              String
  recipient         String
  subject           String
  status            String
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
}

model PaymentRequest {
  id                      String    @id @default(cuid())
  leadId                  String    @unique
  lead                    Lead      @relation(fields: [leadId], references: [id])
  amount                  Float
  currency                String    @default("eur")
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  checkoutUrl             String?
  qrCodeDataUrl           String?
  status                  String    @default("CREATED")
  createdAt               DateTime  @default(now())
  paidAt                  DateTime?
}
